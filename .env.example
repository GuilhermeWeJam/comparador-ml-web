# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto no Supabase
# (Project Settings → API). As duas são públicas por natureza: a segurança vem das regras do banco.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Chave pública: a "publishable key" (sb_publishable_...) ou, em projetos antigos, a "anon public".
VITE_SUPABASE_PUBLISHABLE_KEY=cole-aqui-a-chave-publica
